{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "icare",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "account_id": "181e44a6963cb30381a30edbd56a4b46",
  "routes": [
    { "pattern": "icareltd.com", "custom_domain": true },
    { "pattern": "www.icareltd.com", "custom_domain": true }
  ],
  "vars": {
    "SUPABASE_URL": "https://blflbiwqflidltqflwew.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_Ply3rrROmY-6gNxnppBwvg_eXI-z5pd",
    "SENDER_FROM_EMAIL": "hello@icareltd.com",
    "SENDER_FROM_NAME": "iCare"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "icare"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    // News feed ingestion (src/news-ingest.ts) — every 2 hours. Frequent
    // enough that "today's" feed genuinely reads as today, infrequent
    // enough that a batch of ~80-150 items/run stays a reasonable size
    // (and most of it is a cheap upsert-refresh of items already seen —
    // see news_item_known_external_ids in migration 0049).
    "crons": ["0 */2 * * *"]
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.jpg"], "fallthrough": true }
  ],
  "observability": {
    "enabled": true
  }
}
